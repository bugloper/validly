# Validly configuration. Every variable is optional unless noted.
# Full reference: docs/configuration.md

# --- HTTP ---------------------------------------------------------------
VALIDLY_ADDR=:8080
# Prometheus metrics listener; empty disables it.
VALIDLY_METRICS_ADDR=:9090
VALIDLY_LOG_LEVEL=info
VALIDLY_MAX_BODY_BYTES=8192
VALIDLY_SHUTDOWN_TIMEOUT=15s
# Origins allowed to call the API from browsers (comma-separated).
VALIDLY_CORS_ORIGINS=
# Reverse proxies whose X-Forwarded-For is trusted (IPs or CIDRs).
VALIDLY_TRUSTED_PROXIES=

# --- Authentication and limits -----------------------------------------
# name:secret pairs, comma-separated. Secrets must be at least 16 characters.
VALIDLY_API_KEYS=
VALIDLY_REQUIRE_API_KEY=false
# Enables the admin API (blocklist/allowlist). At least 32 characters.
VALIDLY_ADMIN_TOKEN=
# Requests per minute; 0 disables the limit.
VALIDLY_RATE_LIMIT_IP=60
VALIDLY_RATE_LIMIT_API_KEY=600

# --- DNS and caching ---------------------------------------------------
# Resolver IPs (with optional :port). Defaults to /etc/resolv.conf.
VALIDLY_DNS_SERVERS=
VALIDLY_DNS_TIMEOUT=3s
VALIDLY_DNS_MAX_CONCURRENT=64
VALIDLY_CACHE_MAX_ENTRIES=100000
# Share the DNS cache between replicas, e.g. redis://localhost:6379/0
VALIDLY_REDIS_URL=

# --- Disposable domains and suggestions --------------------------------
# Extra newline-separated domains, reloaded when the file changes.
VALIDLY_DISPOSABLE_FILE=
# HTTPS URL of a newline-separated list, fetched periodically.
VALIDLY_DISPOSABLE_SYNC_URL=
VALIDLY_DISPOSABLE_SYNC_INTERVAL=24h
# Replaces the built-in list of domains used for typo suggestions.
VALIDLY_SUGGESTION_DOMAINS=

# --- PostgreSQL (admin lists, ownership verification) -------------------
VALIDLY_DATABASE_URL=

# --- Ownership verification (needs database, SMTP and URL together) ----
VALIDLY_SMTP_HOST=
VALIDLY_SMTP_PORT=587
VALIDLY_SMTP_USERNAME=
VALIDLY_SMTP_PASSWORD=
VALIDLY_SMTP_FROM=
# "required" refuses servers without STARTTLS; "opportunistic" allows
# plaintext and is meant for local relays such as Mailpit.
VALIDLY_SMTP_TLS=required
# Link emailed to users; {token} is replaced with the token.
VALIDLY_VERIFICATION_URL=
VALIDLY_VERIFICATION_TOKEN_TTL=30m

# --- Tracing (OpenTelemetry, OTLP/HTTP) ---------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
