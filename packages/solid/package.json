{
  "name": "@validly/solid",
  "version": "0.1.0",
  "description": "Validly — Simple email validation for every stack. SolidJS reactive primitives.",
  "license": "MIT",
  "keywords": [
    "email",
    "validation",
    "validly",
    "solid",
    "solidjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/validly/validly.git",
    "directory": "packages/solid"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack ."
  },
  "dependencies": {
    "@validly/core": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "solid-js": "^1.9.17"
  }
}
